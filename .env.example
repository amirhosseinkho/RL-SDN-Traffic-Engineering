# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME="RL-SDN Traffic Engineering"
DEBUG=false
LOG_LEVEL=INFO

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://sdn:sdn_password@localhost:5432/sdn_db

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Ryu Controller ───────────────────────────────────────────────────────────
RYU_HOST=127.0.0.1
RYU_PORT=8080
OPENFLOW_PORT=6653

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── RL Training ──────────────────────────────────────────────────────────────
DQN_LEARNING_RATE=0.0001
DQN_BUFFER_SIZE=100000
DQN_BATCH_SIZE=64
DQN_GAMMA=0.99
DQN_TOTAL_TIMESTEPS=500000

PPO_LEARNING_RATE=0.0003
PPO_N_STEPS=2048
PPO_BATCH_SIZE=64
PPO_TOTAL_TIMESTEPS=1000000

# ─── AI Copilot ───────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
COPILOT_ENABLED=true
